# Server
PORT=5000

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hms?retryWrites=true&w=majority
MONGODB_URI=

# JWT — use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account (used by `npm run seed:admin`)
# To reset an existing admin's password from these values:
#   npm run seed:admin -- --reset
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Login brute-force protection: max FAILED attempts per IP per window
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Logging: fatal | error | warn | info | debug | trace (default info)
LOG_LEVEL=info

# Set when running behind a reverse proxy (nginx, PaaS) so rate limiting
# sees the real client IP. Typical value: 1
# TRUST_PROXY=1
